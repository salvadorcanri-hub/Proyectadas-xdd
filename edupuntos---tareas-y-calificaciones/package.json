{
  "name": "edupuntos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx server.ts",
    "dev:teacher": "vite --mode teacher",
    "dev:student": "vite --mode student",
    "build": "npm run build:teacher && npm run build:student",
    "build:teacher": "vite build --mode teacher",
    "build:student": "vite build --mode student",
    "start": "tsx server.ts",
    "start:teacher": "tsx scripts/serve-app.ts teacher",
    "start:student": "tsx scripts/serve-app.ts student",
    "user:create": "tsx scripts/create-user.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "build:hosted": "node scripts/hosted.mjs build",
    "start:hosted": "node scripts/hosted.mjs start",
    "test:hosted": "npm run build:hosted && SERVE_HOSTED=1 playwright test",
    "build:netlify": "node scripts/build-netlify.mjs",
    "dev:supabase:teacher": "EDUPUNTOS_BACKEND=supabase vite --mode teacher",
    "dev:supabase:student": "EDUPUNTOS_BACKEND=supabase vite --mode student",
    "test:supabase": "node --import tsx --test tests/supabase.test.ts",
    "test:netlify": "node scripts/test-netlify.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "express": "^4.21.2",
    "fflate": "0.8.3",
    "http-proxy": "1.18.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "9.3.12",
    "saxes": "6.0.0",
    "vite": "^8.3.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.2"
}
