# Public browser configuration. Get these from your Supabase project settings.
# In Netlify, enter the actual values in environment variables, not in GitHub.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY
# Never put service_role, sb_secret or a database password in VITE_*.
# DNI login: set SUPABASE_SECRET_KEY only in Netlify's server/Functions environment.
# See STUDENT_ACCOUNTS.md. Do not commit its value to this file.
